# syntax=docker/dockerfile:1
FROM node:24-slim AS base
WORKDIR /app

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/documents/package.json ./packages/documents/package.json
COPY packages/integrations/package.json ./packages/integrations/package.json
COPY packages/rbac/package.json ./packages/rbac/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN npm ci --workspaces --include-workspace-root

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN groupadd --system --gid 1001 nodejs 2>/dev/null || true; useradd --system --uid 1001 --gid nodejs nodejs 2>/dev/null || true
COPY --from=deps /app/node_modules ./node_modules
COPY apps/worker ./apps/worker
COPY packages ./packages
USER nodejs
CMD ["./node_modules/.bin/tsx", "apps/worker/src/index.ts"]
