# PETORA INDONESIA
# Database URL (dihasilkan otomatis oleh Docker compose bila tidak diisi)
DATABASE_URL=postgresql://petora:${POSTGRES_PASSWORD}@localhost:5432/petora
POSTGRES_PASSWORD=
# Redis URL
REDIS_URL=redis://localhost:6379
# Override AUTH_SECRET (init Docker membuat dan menyimpan nilai bila kosong)
AUTH_SECRET=
# Override kunci AES-256 base64url (init Docker membuat dan menyimpan nilai bila kosong)
ENCRYPTION_MASTER_KEY=
# Batasi percobaan login (bucket per identitas dan per IP)
AUTH_LOGIN_IDENTIFIER_ATTEMPTS=5
AUTH_LOGIN_IDENTIFIER_WINDOW_SECONDS=900
AUTH_LOGIN_IDENTIFIER_BLOCK_SECONDS=900
AUTH_LOGIN_IP_ATTEMPTS=30
AUTH_LOGIN_IP_WINDOW_SECONDS=900
AUTH_LOGIN_IP_BLOCK_SECONDS=900
# Batasi enrollment dan verifikasi TOTP
AUTH_TOTP_IDENTIFIER_ATTEMPTS=5
AUTH_TOTP_IDENTIFIER_WINDOW_SECONDS=300
AUTH_TOTP_IDENTIFIER_BLOCK_SECONDS=900
AUTH_TOTP_IP_ATTEMPTS=20
AUTH_TOTP_IP_WINDOW_SECONDS=300
AUTH_TOTP_IP_BLOCK_SECONDS=900
# Domain aplikasi (localhost untuk lokal; domain publik untuk HTTPS/webhook)
PETORA_DOMAIN=localhost
# Mode
NODE_ENV=production
