# PETORA INDONESIA
# Database URL (dihasilkan otomatis oleh Docker compose bila tidak diisi)
DATABASE_URL=postgresql://petora:${POSTGRES_PASSWORD}@localhost:5432/petora
POSTGRES_PASSWORD=
# Redis URL
REDIS_URL=redis://localhost:6379
# Kunci sesi (dihasilkan otomatis bila kosong)
AUTH_SECRET=
# Kunci enkripsi master (dihasilkan otomatis bila kosong)
ENCRYPTION_MASTER_KEY=
# Domain aplikasi (wajib untuk HTTPS/webhook)
PETORA_DOMAIN=
LETSENCRYPT_EMAIL=
# Mode
NODE_ENV=production
